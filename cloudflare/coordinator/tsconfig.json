{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}
